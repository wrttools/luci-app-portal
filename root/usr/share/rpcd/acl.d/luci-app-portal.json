{
	"luci-app-portal": {
		"description": "Grant access to the Portal configuration",
		"read": {
			"file": {
				"/etc/portal/www": [ "list" ],
				"/etc/portal/www/*": [ "list" ],
				"/etc/portal/www/bg": [ "list" ],
				"/etc/portal/www/bg/*": [ "list" ],
				"/etc/portal/www/icons": [ "list" ],
				"/etc/portal/www/icons/*": [ "list" ]
			},
			"ubus": {
				"file": [ "list" ],
				"luci.portal": [ "scan", "status" ]
			},
			"uci": [ "portal" ]
		},
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/tmp/portal_upload.tmp": [ "read", "write" ]
			},
			"ubus": {
				"luci.portal": [ "generate", "upload", "rename", "remove" ]
			},
			"uci": [ "portal" ]
		}
	}
}
