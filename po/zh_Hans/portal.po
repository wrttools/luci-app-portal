#: htdocs/luci-static/resources/view/portal/general.js:40
#: htdocs/luci-static/resources/view/portal/general.js:109
#, javascript-format
msgid "Service %d"
msgstr "服务 %d"

#: htdocs/luci-static/resources/view/portal/general.js:78
msgid "Unrecognised ports"
msgstr "未识别的端口"

#: htdocs/luci-static/resources/view/portal/general.js:79
#, javascript-format
msgid "These listening ports could not be classified: %s"
msgstr "以下监听端口无法判定类型：%s"

#: htdocs/luci-static/resources/view/portal/general.js:81
msgid ""
"A port number does not say which protocol is spoken on it, so they were "
"neither added nor dropped automatically."
msgstr "端口号本身不表示其上使用的协议，因此既未自动添加，也未自动丢弃。"

#: htdocs/luci-static/resources/view/portal/general.js:87
msgid "Ignore"
msgstr "忽略"

#: htdocs/luci-static/resources/view/portal/general.js:118
#: htdocs/luci-static/resources/view/portal/general.js:229
#, javascript-format
msgid "Added %d disabled bookmark(s) - tick the ones you want and apply."
msgstr "已添加 %d 个默认禁用的书签，勾选需要的后应用即可。"

#: htdocs/luci-static/resources/view/portal/general.js:125
msgid "Add as disabled bookmarks"
msgstr "添加为禁用书签"

#: htdocs/luci-static/resources/view/portal/general.js:143
msgid "Portal"
msgstr "门户"

#: htdocs/luci-static/resources/view/portal/general.js:144
msgid ""
"A static HTML portal served by its own uhttpd instance on a dedicated port. "
"Settings are persisted in uci and baked into links.json on apply."
msgstr ""
"由独立 uhttpd 实例在指定端口上提供服务的静态 HTML 门户。设置保存在 uci 中，应"
"用时烘焙进 links.json。"

#: htdocs/luci-static/resources/view/portal/general.js:149
msgid "General"
msgstr "常规"

#: htdocs/luci-static/resources/view/portal/general.js:158
msgid "Enable portal"
msgstr "启用门户"

#: htdocs/luci-static/resources/view/portal/general.js:159
msgid ""
"Turn the portal service on or off. When off, the uhttpd instance is stopped "
"and the port is closed."
msgstr "开启或关闭门户服务。关闭后 uhttpd 实例会停止，端口不再监听。"

#: htdocs/luci-static/resources/view/portal/general.js:164
msgid "Listen port"
msgstr "监听端口"

#: htdocs/luci-static/resources/view/portal/general.js:172
msgid "Ports 80 and 8080 are reserved by the main web server."
msgstr "80 与 8080 端口已被主 Web 服务器占用。"

#: htdocs/luci-static/resources/view/portal/general.js:175
msgid "This port is already used by the main uhttpd instance."
msgstr "该端口已被主 uhttpd 实例占用。"

#: htdocs/luci-static/resources/view/portal/general.js:180
msgid "Page title"
msgstr "页面标题"

#: htdocs/luci-static/resources/view/portal/general.js:183
msgid "Background colour"
msgstr "背景颜色"

#: htdocs/luci-static/resources/view/portal/general.js:184
msgid "A CSS colour value such as #0e1116."
msgstr "CSS 颜色值，例如 #0e1116。"

#: htdocs/luci-static/resources/view/portal/general.js:192
msgid "Current background image"
msgstr "当前背景图片"

#: htdocs/luci-static/resources/view/portal/general.js:193
msgid "Chosen on the Assets page. It takes precedence over the colour."
msgstr "在「素材库」页选择，优先级高于背景颜色。"

#: htdocs/luci-static/resources/view/portal/general.js:210
msgid "Background veil"
msgstr "背景遮罩强度"

#: htdocs/luci-static/resources/view/portal/general.js:211
msgid ""
"How strongly a background image is dimmed, in percent. 0 leaves the photo as "
"it is, 100 hides it behind a solid scrim. Only applies when a background "
"image is set."
msgstr ""
"背景图被压暗的程度（百分比）。0 表示保持照片原样，100 表示用纯色遮罩完全盖住。"
"仅在设置了背景图时生效。"

#: htdocs/luci-static/resources/view/portal/general.js:221
msgid "Background blur"
msgstr "背景磨砂模糊"

#: htdocs/luci-static/resources/view/portal/general.js:222
msgid ""
"Frosted-glass blur applied to a background image, in percent of the maximum "
"(20 px). 0 keeps the photo sharp."
msgstr ""
"对背景图施加的磨砂模糊，以最大值（20 px）的百分比表示。0 表示照片保持清晰。"

#: htdocs/luci-static/resources/view/portal/general.js:232
msgid "Bookmark transparency"
msgstr "书签透明度"

#: htdocs/luci-static/resources/view/portal/general.js:233
msgid ""
"Transparency of the bookmark cards, in percent. 0 makes them solid, 100 lets "
"the background shine through completely; the text stays readable either way."
msgstr ""
"书签卡片的透明度（百分比）。0 表示完全不透明，100 表示背景完全透出；"
"两种取值下文字都保持可读。"

#: htdocs/luci-static/resources/view/portal/general.js:197
msgid "none"
msgstr "无"

#: htdocs/luci-static/resources/view/portal/general.js:202
msgid "Maintenance"
msgstr "维护"

#: htdocs/luci-static/resources/view/portal/general.js:206
msgid "Static page"
msgstr "静态页面"

#: htdocs/luci-static/resources/view/portal/general.js:207
msgid "Regenerate links.json now"
msgstr "立即重新生成 links.json"

#: htdocs/luci-static/resources/view/portal/general.js:213
#, javascript-format
msgid "Regenerated: %d bookmark(s)."
msgstr "已重新生成：%d 个书签。"

#: htdocs/luci-static/resources/view/portal/general.js:220
msgid "Discovery"
msgstr "服务发现"

#: htdocs/luci-static/resources/view/portal/general.js:221
msgid "Scan local services & add (disabled)"
msgstr "扫描本地服务并添加（默认禁用）"

#: htdocs/luci-static/resources/view/portal/general.js:233
#, javascript-format
msgid "Added %d bookmark(s); %d port(s) were not recognised."
msgstr "已添加 %d 个书签，另有 %d 个端口未能识别。"

#: htdocs/luci-static/resources/view/portal/general.js:237
msgid "No new local services found."
msgstr "未发现新的本地服务。"

