#!/bin/sh /etc/rc.common
# Pure-HTML portal: dedicated uhttpd instance on a user-configured port.
USE_PROCD=1
START=95
STOP=10

start_service() {
    local port title
    port=$(uci -q get portal.@portal[0].port || echo 8180)
    title=$(uci -q get portal.@portal[0].title || echo Portal)

    [ -d /etc/portal/www ] || mkdir -p /etc/portal/www/icons /etc/portal/www/bg
    [ -f /etc/portal/www/index.html ] || cp -r /usr/share/portal/www/. /etc/portal/www/ 2>/dev/null

    procd_open_instance
    procd_set_param command /usr/sbin/uhttpd -f -h /etc/portal/www -p ":$port" -r "$title"
    procd_set_param respawn
    procd_close_instance
}

reload_service() {
    restart_service
}

service_triggers() {
    procd_add_reload_trigger "portal"
}
