#!/bin/sh /etc/rc.common
# Pure-HTML portal: dedicated uhttpd instance on a user-configured port.

USE_PROCD=1
START=95
STOP=10

PORTAL_WWW=/etc/portal/www

prepare_www() {
	mkdir -p "$PORTAL_WWW/icons" "$PORTAL_WWW/bg"
	[ -f "$PORTAL_WWW/index.html" ] || cp -r /usr/share/portal/www/. "$PORTAL_WWW/" 2>/dev/null
}

# Re-bake links.json from uci. The generator is the `luci.portal` ubus object
# provided by the rpcd plugin, so there is exactly one loader of that script
# and no second code path to keep in sync.
generate_links() {
	ubus call luci.portal generate >/dev/null 2>&1
}

start_service() {
	local enabled port

	# The configuration switch. Absent - a configuration written before the
	# switch existed - counts as enabled; only an explicit '0' stops the
	# portal. Not config_get_bool: `config portal` is an anonymous section,
	# so config_get would look up CONFIG_portal_enabled, which never exists,
	# and silently return its default.
	enabled=$(uci -q get portal.@portal[0].enabled)
	[ "$enabled" = "0" ] && return 0

	port=$(uci -q get portal.@portal[0].port)
	[ -n "$port" ] || port=8180

	prepare_www
	generate_links

	procd_open_instance
	# uhttpd parses -p as [addr:]port. Passing a bare ":PORT" leaves the
	# address empty; getaddrinfo() then fails with "Name does not resolve",
	# uhttpd reports "No sockets bound, unable to continue" and exits, so the
	# portal is never reachable. Bind the IPv4 wildcard explicitly.
	# (Note: -r is uhttpd's basic auth realm, not a page title.)
	procd_set_param command /usr/sbin/uhttpd -f -h "$PORTAL_WWW" -p "0.0.0.0:$port"
	procd_set_param respawn
	procd_close_instance
}

# A configuration change runs `/etc/init.d/portal reload`. Under USE_PROCD the
# rc.common default reload() (restart) is replaced with one that calls
# start_service() when no reload_service() is defined, and start() hands procd a
# complete `service set`. Two consequences we rely on: the instance is recreated
# when its settings changed, and an instance that is no longer declared - because
# the switch above turned the portal off - is stopped. So the portal starts and
# stops without a reboot.
#
# The trigger is registered on every service set, including the early return in
# start_service(), so the switch keeps working after the portal was turned off.
service_triggers() {
	procd_add_reload_trigger "portal"
}
